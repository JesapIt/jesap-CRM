# Example of environment variables
# To run locally, project already contains safe patterns defined in the settings.py
# But if you must test as production, copy this file and rename it to .env, then change the values below:

DEBUG=True
SECRET_KEY=secret_development_key_goes_here
ALLOWED_HOSTS=127.0.0.1,localhost

# In production (Railway): set DEBUG=False and provide:
#   ALLOWED_HOSTS=<your-app>.up.railway.app
#   CSRF_TRUSTED_ORIGINS=https://<your-app>.up.railway.app
#   USE_POSTGRES=1
#   PGSSLMODE=require
#   LOG_LEVEL=INFO
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app

# URL pubblica del sito (usata nei link delle email). Senza slash finale.
SITE_URL=https://crm.jesap.it

# Database
# If DATABASE_URL is set, Django uses PostgreSQL (e.g. Supabase). Omit it or set USE_SQLITE=true to use db.sqlite3.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Optional: force SQLite even when DATABASE_URL is present (offline dev)
# USE_SQLITE=true
# Force Postgres in production (raises if DATABASE_URL missing)
# USE_POSTGRES=1
# Supabase requires sslmode=require
# PGSSLMODE=require
# If the pooler host fails DNS/SSL, try the direct DB host (db.<project-ref>.supabase.co)
# SUPABASE_DIRECT_DB_HOST=

# Email (SMTP — Google Workspace)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587


EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@jesap.it
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=JESAP CRM <noreply@jesap.it>

# ── Sync Google Sheets <-> Supabase (sync/soci_sync.py) ───────────────────────
# Supabase REST API — usa la "service role" key (NON la anon key)
# Trovale su: Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Percorso al file JSON del service account Google Cloud
# Guida creazione: https://docs.gspread.org/en/latest/oauth2.html#service-account
GOOGLE_CREDS_PATH=sync/google_credentials.json